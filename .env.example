# Copy this file to .env and set a unique, private token.
APP_API_TOKEN=replace-with-a-long-random-secret

# Optional. Without a key, chat returns the retrieved source passages rather than a generated summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# The BGE embedding and reranker models are downloaded on first document upload/chat.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

MYPRODUCTCARE_API_URL=http://127.0.0.1:8000
# Optional custom storage locations:
# MYPRODUCTCARE_DATA_DIR=./data
# QDRANT_PATH=./data/qdrant
# MAX_UPLOAD_BYTES=20971520
