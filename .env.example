# Copy this file to .env. Users create accounts in the application.

# Choose "openai" or "gemini". Without the selected provider key, chat returns retrieved source passages.
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# The BGE embedding and reranker models are downloaded on first document upload/chat.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

MYPRODUCTCARE_API_URL=http://127.0.0.1:8000
# Optional custom storage locations:
# MYPRODUCTCARE_DATA_DIR=./data
# QDRANT_PATH=./data/qdrant
# MAX_UPLOAD_BYTES=20971520
